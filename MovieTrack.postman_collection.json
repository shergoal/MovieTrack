    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000/api/v1"
    },
    {
      "key": "adminEmail",
      "value": ""
    },
    {
      "key": "adminPassword",
      "value": ""
    },
    {
      "key": "staffEmail",
      "value": ""
    },
    {
      "key": "staffPassword",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "staffToken",
      "value": ""
    },
    {
      "key": "userId",
      "value": ""
