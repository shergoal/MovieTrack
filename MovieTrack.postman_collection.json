{
  "info": {
    "name": "MovieTrack Final Project",
    "description": "Run in order against a local MovieTrack database. Set adminEmail, adminPassword, staffEmail, and staffPassword as local Postman environment values. Use a new staff email and a password of at least 12 characters. The suite creates and removes its own demo records.",
