{
  "name": "movietrack-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "start:dev": "node --watch --env-file-if-exists=.env server.mjs",
    "build": "node --check server.mjs && node --check movietrack.controller.mjs && node --check movietrack.service.mjs && node --check database.mjs && node --check auth.mjs && node --check reports.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.11",
    "@nestjs/core": "^11.2.11",
    "@nestjs/platform-express": "^11.2.11",
    "mysql2": "^3.24.6",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^0.3.31"
  }
}
